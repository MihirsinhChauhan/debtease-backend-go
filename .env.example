# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Docker (docker compose up -d postgres):
#   postgres://postgres:postgres@localhost:5432/debtease?sslmode=disable
# Homebrew Postgres on macOS (role = your macOS username, often no password):
#   postgres://YOUR_USERNAME@localhost:5432/debtease?sslmode=disable
DB_URL=postgres://postgres:postgres@localhost:5432/debtease?sslmode=disable

# Secret used to sign JWT access/refresh tokens (use a long random string)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# -----------------------------------------------------------------------------
# Migrations (goose — required for ./scripts/migrate.sh and make migrate)
# -----------------------------------------------------------------------------

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/debtease?sslmode=disable

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# HTTP port (defaults to 8080 if unset)
PORT=8080

# Deployment target: web, webapp, mobile, prod, etc.
# When ENV=production or PLATFORM=prod, logs use JSON format.
PLATFORM=web

# Set to "production" on deployed environments (affects log formatting)
ENV=development

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------

# Comma-separated list of emails allowed to access /admin routes
ADMIN_EMAILS=admin@example.com

# -----------------------------------------------------------------------------
# Google OAuth (optional — required only for Google sign-in)
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
GOOGLE_LOGIN_SUCCESS_REDIRECT=http://localhost:3000/dashboard

# -----------------------------------------------------------------------------
# Credit card statements (PDF upload)
# -----------------------------------------------------------------------------

# Local directory for stored statement PDFs (defaults to ./data/statements)
STATEMENT_STORAGE_PATH=./data/statements

# -----------------------------------------------------------------------------
# Email notifications (optional — required only if RabbitMQ notifications are enabled)
# -----------------------------------------------------------------------------

# RESEND_API_KEY=
# FROM_EMAIL=DebtEase <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# RabbitMQ (optional — currently disabled in main.go)
# -----------------------------------------------------------------------------

# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
